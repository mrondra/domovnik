# ---- Postgres (main database) ----
# Application role: must NOT own the tables and must NOT have BYPASSRLS (ADR 0013).
DATABASE_URL=postgresql://domovnik_app:domovnik@localhost:5432/domovnik
# Schema owner: migrations, seed and withSystem(). Falls back to DATABASE_URL when unset.
DATABASE_ADMIN_URL=postgresql://domovnik:domovnik@localhost:5432/domovnik

# ---- Secrets ----
# HMAC key for session tokens, API token hashes and signed one-time links (min. 32 chars).
APP_SECRET=change-me-to-at-least-32-characters

# ---- MinIO (S3-compatible object storage) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=domovnik
S3_SECRET_KEY=domovnik123
S3_BUCKET=domovnik
# Lifetime of a presigned download link, in seconds.
S3_PRESIGN_TTL_SECONDS=900

# ---- Langfuse (LLM observability, optional) ----
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Anthropic (LLM provider) ----
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# ---- Agent runtime ----
AGENT_MAX_CONCURRENCY=4
AGENT_TENANT_MAX_CONCURRENCY=2
AGENT_TOKEN_BUDGET=200000

# ---- LLM record/replay ----
LLM_MODE=live
LLM_FIXTURE_DIR=fixtures/llm

# ---- Web (apps/web) ----
# Where the web application reaches the API. It holds nothing else from this file.
API_URL=http://localhost:3001

# ---- App ----
NODE_ENV=development
LOG_LEVEL=debug
