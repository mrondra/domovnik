{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["dot"],
  "workspaces": {
    "apps/api": {
      "entry": ["src/bin/*.ts"],
      "ignoreDependencies": ["@node-rs/argon2", "drizzle-orm", "pg", "pino"]
    },
    "packages/kernel": {},
    "packages/shared": {},
    "packages/db": {}
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error"
  }
}
