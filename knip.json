{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["dot"],
  "workspaces": {
    "packages/kernel": {},
    "packages/shared": {},
    "packages/db": {}
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error"
  }
}
