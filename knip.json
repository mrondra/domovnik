{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["dot"],
  "workspaces": {
    "apps/*": {},
    "apps/api": {
      "entry": ["src/bin/*.ts"],
      "ignoreDependencies": [
        "@anthropic-ai/sdk",
        "@aws-sdk/client-s3",
        "@aws-sdk/s3-request-presigner",
        "@node-rs/argon2",
        "drizzle-orm",
        "fast-xml-parser",
        "langfuse",
        "pdf-parse",
        "pg",
        "pg-boss",
        "pino"
      ]
    },
    "apps/web": {
      "entry": ["src/bin/*.ts", "e2e/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/bin/*.ts"]
    },
    "packages/features/*": {},
    "packages/kernel": {},
    "packages/shared": {}
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error"
  }
}
