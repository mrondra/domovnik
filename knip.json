{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["dot"],
  "workspaces": {
    "apps/*": {},
    "apps/api": {
      "entry": ["src/bin/*.ts"],
      "ignoreDependencies": [
        "@anthropic-ai/sdk",
        "@aws-sdk/client-s3",
        "@aws-sdk/s3-request-presigner",
        "@node-rs/argon2",
        "drizzle-orm",
        "fast-xml-parser",
        "langfuse",
        "pdf-parse",
        "pg",
        "pg-boss",
        "pino"
      ]
    },
    "apps/web": {
      "entry": ["src/bin/*.ts", "e2e/**/*.ts"]
    },
    "packages/db": {
      "entry": ["src/bin/*.ts"]
    },
    "packages/features/*": {},
    "packages/kernel": {},
    "packages/shared": {}
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "files": "error",
    "unlisted": "error",
    "exports": "error",
    "types": "error",
    "dependencies": "error"
  },
  // knip si cestu k hookům zjišťuje přes `git rev-parse --git-path hooks`. V git
  // worktree to ukáže do hlavního repa, glob se vydá mimo pracovní adresář a v
  // sandboxu agenta narazí — načež celé hledání konfigurace vrátí prázdno a knip
  // hlásí jako nepoužité soubory, které se používají. Tady mu řekneme, kde
  // hledat, takže se cesta k hookům vůbec nepočítá. Nic se neztrácí: generované
  // soubory v .git/hooks nenesou nic, co by nebylo v lefthook.yml.
  "lefthook": { "config": ["lefthook.yml"] }
}
