{
  "name": "domovnik",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "docker compose up -d && turbo dev",
    "build": "turbo build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo typecheck",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "depcruise:graph": "depcruise apps packages --config .dependency-cruiser.cjs --output-type dot | dot -T svg > docs/dependency-graph.svg",
    "knip": "knip",
    "test": "vitest run --project unit --project integration --passWithNoTests",
    "test:evals": "vitest run --project evals",
    "test:e2e": "pnpm --filter @domovnik/web test:e2e",
    "verify": "pnpm lint && pnpm typecheck && pnpm depcruise && pnpm knip && pnpm test",
    "gen:feature": "tsx tooling/generators/feature.ts",
    "gen:agent": "tsx tooling/generators/agent.ts",
    "gen:tool": "tsx tooling/generators/tool.ts",
    "adr:new": "tsx tooling/generators/adr.ts",
    "db:generate": "pnpm --filter @domovnik/db generate",
    "db:migrate": "pnpm --filter @domovnik/db migrate",
    "db:seed": "pnpm --filter @domovnik/db seed",
    "api:modules": "pnpm --filter @domovnik/api compose",
    "web:navigation": "pnpm --filter @domovnik/web compose",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "knip": "^6.35.1",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
