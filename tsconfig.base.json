{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@domovnik/kernel": ["./packages/kernel/src/index.ts"],
      "@domovnik/kernel/*": ["./packages/kernel/src/*"],
      "@domovnik/shared": ["./packages/shared/src/index.ts"],
      "@domovnik/db": ["./packages/db/src/index.ts"],
      "@domovnik/features/*": ["./packages/features/*/index.ts"]
    }
  }
}
